AUTOWISE_DATABASE_URL=postgresql+psycopg://autowise:autowise@localhost:5432/autowise
AUTOWISE_JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
AUTOWISE_ADMIN_EMAIL=admin@autowise.local
AUTOWISE_ADMIN_PASSWORD=change-me-now
AUTOWISE_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Адреса сайту для посилань у листах
AUTOWISE_APP_URL=http://localhost:3000
# Пошта. Без AUTOWISE_SMTP_HOST листи лише пишуться в журнал сервера.
AUTOWISE_SMTP_HOST=
AUTOWISE_SMTP_PORT=587
AUTOWISE_SMTP_USER=
AUTOWISE_SMTP_PASSWORD=
AUTOWISE_SMTP_FROM=AutoWise <no-reply@your-domain>
