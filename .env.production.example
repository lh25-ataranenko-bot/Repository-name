# Copy to .env next to docker-compose.prod.yml and fill in. Never commit the real .env.

# Your domain; its DNS A record must point to this server before the first start.
DOMAIN=autowise.ua

# Long random values, e.g. from:  openssl rand -base64 48
POSTGRES_PASSWORD=
AUTOWISE_JWT_SECRET=

# First administrator (created on the first start only; change the password in the cabinet afterwards)
AUTOWISE_ADMIN_EMAIL=admin@autowise.ua
AUTOWISE_ADMIN_PASSWORD=

# Mail for email confirmation and password reset (any SMTP provider)
AUTOWISE_SMTP_HOST=
AUTOWISE_SMTP_PORT=587
AUTOWISE_SMTP_USER=
AUTOWISE_SMTP_PASSWORD=
AUTOWISE_SMTP_FROM=AutoWise <no-reply@autowise.ua>

# AI assistant (optional). Without it the assistant answers with the rule-based picker.
ANTHROPIC_API_KEY=

# 1 = load the 47 demo modifications on the first start; 0 = empty catalogue for your own import
AUTOWISE_SEED_DEMO=1
UVICORN_WORKERS=2
BACKUP_KEEP_DAYS=14
